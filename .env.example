# ==============================================================================
# PALASH VANI — Environment Configuration for Local Backend & XAMPP MySQL
# ==============================================================================

# Node.js API Server Port
PORT=5000

# Local XAMPP MySQL / MariaDB Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=palash
DB_USER=root
DB_PASSWORD=

# Security & CORS
CORS_ORIGIN=*

# Offline-First Policy (true: fallback to memory/cache if MySQL is down)
OFFLINE_FALLBACK=true
